# Database connection

## Licencia de Liquibase Pro
#LIQUIBASE_LICENSE_KEY=<inserte el key de la licencia>

## URL de conexión para aurora
#LIQUIBASE_COMMAND_URL=jdbc:postgresql://cluster-name.cluster-xyz.region.rds.amazonaws.com:5432/db

## URL de conexión para base de datos local 
LIQUIBASE_COMMAND_URL=jdbc:postgresql://postgres:5432/myapp
LIQUIBASE_COMMAND_USERNAME=dbuser
LIQUIBASE_COMMAND_PASSWORD=secretpassword
LIQUIBASE_COMMAND_DRIVER=org.postgresql.Driver


# Liquibase configuration
LIQUIBASE_COMMAND_CHANGELOG_FILE=changelog/db.changelog-master.xml
LIQUIBASE_LOG_LEVEL=DEBUG
LIQUIBASE_HUB_MODE=off


# Optional: Environment specific
#ENVIRONMENT=production
ENVIRONMENT=development

